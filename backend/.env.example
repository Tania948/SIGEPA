# Copia este archivo como .env (en la carpeta backend) y ajusta tus datos.

PORT=3000

# ---- Base de datos: opción A, MySQL en tu computadora ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sigepa

# ---- Opción B, base en la nube (TiDB Cloud): cambia los datos de arriba por los del botón "Connect" ----
# DB_HOST=gateway01.us-east-1.prod.aws.tidbcloud.com
# DB_PORT=4000
# DB_USER=2abc3XYZ.root
# DB_PASSWORD=tu-contraseña
# DB_NAME=sigepa
# DB_SSL=true
# (También puedes usar una sola línea: DATABASE_URL=mysql://USUARIO:CONTRASEÑA@HOST:4000/sigepa)

# Firma de las sesiones. En producción usa un texto largo y secreto.
JWT_SECRET=cambia-esta-clave

# Al arrancar, la API crea las tablas y carga los datos de ejemplo si la base está vacía.
# Pon false si prefieres hacerlo a mano con database/esquema.sql y database/datos.sql.
DB_PREPARAR=true
