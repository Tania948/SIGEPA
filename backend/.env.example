# Copia este archivo como .env y ajusta tus datos de MySQL
PORT=3000
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=sigepa
JWT_SECRET=cambia-esta-clave

# Asistente (opcional). Sin llave, el asistente responde con sus reglas y los datos de SIGEPA.
# Con una llave de la API de Anthropic, además redacta las respuestas con Claude usando esos mismos datos.
ANTHROPIC_API_KEY=
ASISTENTE_MODELO=claude-haiku-5-5
